---
import Layout from './Layout.astro';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---
<Layout title={`${title} | Park 101`} description={description}>
  <section class="legal-page max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28" aria-labelledby="legal-title">
    <header class="mb-12">
      <h1 id="legal-title" class="font-display font-bold uppercase tracking-display text-brand-steel text-4xl sm:text-5xl mb-4">{title}</h1>
      <p class="text-sm text-brand-dark/70 mb-4">Park 101 — Carlsbad, CA</p>
      <p class="text-sm text-brand-dark/70">Last updated: <time datetime="2026-10-29">October 29, 2026</time></p>
      <nav aria-label="Legal information" class="flex flex-wrap gap-x-6 gap-y-3 mt-6 text-sm">
        <a href="/privacy" aria-current={currentPath === '/privacy' ? 'page' : undefined}>Privacy Policy</a>
        <a href="/terms" aria-current={currentPath === '/terms' ? 'page' : undefined}>Terms of Service</a>
        <a href="/privacy#choices">Your Privacy Choices</a>
      </nav>
    </header>
    <div class="legal-content"><slot /></div>
  </section>
</Layout>
<style>
  @layer components {
    .legal-page { overflow-wrap: anywhere; }
    .legal-page :global(a) { color: var(--color-brand-steel); text-decoration: underline; text-underline-offset: 3px; }
    .legal-page :global(a:hover) { text-decoration-thickness: 2px; }
    .legal-page :global(a:focus-visible), .legal-page :global(button:focus-visible) { outline: 2px solid var(--color-brand-steel); outline-offset: 4px; }
    .legal-content :global(h2) { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; line-height: 1.3; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-brand-steel); margin: 3rem 0 1.25rem; }
    .legal-content :global(p), .legal-content :global(address), .legal-content :global(li) { font-size: 1rem; line-height: 1.75; color: var(--color-brand-dark); }
    .legal-content :global(p) { margin-bottom: 1.25rem; }
    .legal-content :global(address) { font-style: normal; }
    .legal-content :global(ul) { padding-left: 1.5rem; list-style: disc; margin-bottom: 1.25rem; }
    .legal-content :global(li) { margin-bottom: 0.5rem; }
    .legal-content :global([id]) { scroll-margin-top: 6rem; }
  }
</style>
