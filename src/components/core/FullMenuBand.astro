---
interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
}

const { eyebrow, heading, body, ctaLabel, ctaHref } = Astro.props;
---

<section class="relative bg-brand-steel-dark py-20 px-6 sm:px-8 lg:px-12 text-center">
  <div class="max-w-2xl mx-auto">
    <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">{eyebrow}</span>
    <h2 class="font-display font-bold text-4xl sm:text-5xl text-brand-white uppercase tracking-tight">{heading}</h2>
    <div class="w-12 h-[2px] bg-brand-orange mx-auto mt-5 mb-6"></div>
    <p class="font-body font-light text-brand-cream/80 text-base sm:text-lg leading-relaxed mb-8">{body}</p>
    <a
      href={ctaHref}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block px-8 py-4 bg-brand-orange hover:bg-brand-orange-dark text-brand-white font-display font-bold uppercase tracking-button text-sm transition-colors duration-200"
    >
      {ctaLabel}
    </a>
  </div>
</section>
