---
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---
{GA_ID && (
  <script is:inline define:vars={{ GA_ID }}>
    (function () {
      var STORAGE_KEY = 'lilos-privacy-v1';

      function readOptOut() {
        try {
          var raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return false;
          var parsed = JSON.parse(raw);
          return !!(parsed && parsed.optOut === true);
        } catch (e) {
          return false;
        }
      }

      function writeOptOut(value) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({ optOut: value, ts: Date.now() }));
        } catch (e) {}
      }

      function initAnalytics() {
        if (window.__lilosGA4Loaded) return;
        window.__lilosGA4Loaded = true;

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());

        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'granted'
        });

        window.gtag('config', GA_ID, {
          allow_google_signals: false,
          allow_ad_personalization_signals: false
        });

        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
        document.head.appendChild(s);

        // Toast conversion + phone click tracking.
        document.addEventListener('click', function (e) {
          const link = e.target.closest('a[href*="toasttab.com"], a[href*="toast.app"], a[href^="tel:"]');
          if (!link) return;

          let eventName = 'toast_link_click';
          if (link.href.startsWith('tel:')) {
            eventName = 'phone_click';
          } else {
            try {
              const host = new URL(link.href).hostname;
              if (host === 'toast.app' || host.endsWith('.toast.app') || host.includes('tables.toasttab.com')) {
                eventName = 'reservation_click';
              } else if (host.includes('order.toasttab.com')) {
                eventName = 'order_click';
              } else if (link.href.includes('invoice/lead')) {
                eventName = 'inquiry_form_click';
              } else if (link.href.toLowerCase().includes('gift')) {
                eventName = 'gift_card_click';
              }
            } catch (err) {}
          }

          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, {
              link_url: link.href,
              page_path: window.location.pathname,
            });
          }
        }, { passive: true });
      }

      window.lilosPrivacy = {
        isOptedOut: function () {
          return readOptOut();
        },
        optOut: function () {
          writeOptOut(true);
          window['ga-disable-' + GA_ID] = true;
        },
        optIn: function () {
          writeOptOut(false);
          window['ga-disable-' + GA_ID] = false;
          initAnalytics();
        }
      };

      // Honor GPC automatically. Otherwise GA4 loads by default unless the
      // visitor explicitly opted out under the current privacy controls.
      if (navigator.globalPrivacyControl === true) return;

      if (readOptOut()) {
        window['ga-disable-' + GA_ID] = true;
        return;
      }

      initAnalytics();
    })();
  </script>
)}
