---
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---
{GA_ID && (
  <script is:inline define:vars={{ GA_ID }}>
    (function () {
      var NEW_KEY = 'lilos-privacy-v1';
      var OLD_KEY = 'lilos-consent-v1';

      function readOptOut() {
        try {
          var raw = localStorage.getItem(NEW_KEY);
          if (raw) {
            var parsed = JSON.parse(raw);
            if (parsed && typeof parsed.optOut === 'boolean') return parsed.optOut;
          }
          // Migration: check old consent record
          var oldRaw = localStorage.getItem(OLD_KEY);
          if (oldRaw) {
            var old = JSON.parse(oldRaw);
            if (old && old.analytics === false) {
              // Previously rejected — migrate as opt-out
              var ts = (typeof old.ts === 'number') ? old.ts : Date.now();
              localStorage.setItem(NEW_KEY, JSON.stringify({ optOut: true, ts: ts }));
              return true;
            }
          }
        } catch (e) {}
        return false; // default opted in
      }

      function writeOptOut(value) {
        try {
          localStorage.setItem(NEW_KEY, JSON.stringify({ optOut: value, ts: Date.now() }));
        } catch (e) {}
      }

      function initAnalytics() {
        if (window.__lilosGA4Loaded) return;
        window.__lilosGA4Loaded = true;

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());

        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'granted'
        });

        window.gtag('config', GA_ID, {
          allow_google_signals: false,
          allow_ad_personalization_signals: false
        });

        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
        document.head.appendChild(s);

        // Toast + phone click-tracking
        document.addEventListener('click', function (e) {
          const link = e.target.closest('a[href*="toasttab.com"], a[href^="tel:"]');
          if (!link) return;

          let eventName = 'toast_link_click';
          if (link.href.startsWith('tel:')) {
            eventName = 'phone_click';
          } else {
            try {
              const host = new URL(link.href).hostname;
              if (host.includes('tables.toasttab.com')) eventName = 'reservation_click';
              else if (host.includes('order.toasttab.com')) eventName = 'order_click';
              else if (link.href.includes('invoice/lead')) eventName = 'inquiry_form_click';
              else if (link.href.toLowerCase().includes('gift')) eventName = 'gift_card_click';
            } catch (err) {}
          }

          if (typeof gtag === 'function') {
            gtag('event', eventName, {
              link_url: link.href,
              page_path: window.location.pathname,
            });
          }
        }, { passive: true });
      }

      // Expose window.lilosPrivacy API
      window.lilosPrivacy = {
        isOptedOut: function () {
          try {
            var raw = localStorage.getItem(NEW_KEY);
            if (!raw) return false;
            var parsed = JSON.parse(raw);
            return !!(parsed && parsed.optOut);
          } catch (e) { return false; }
        },
        optOut: function () {
          writeOptOut(true);
          window['ga-disable-' + GA_ID] = true;
        },
        optIn: function () {
          writeOptOut(false);
          window['ga-disable-' + GA_ID] = false;
          initAnalytics();
        }
      };

      // Load GA4 unless opted out or GPC
      if (navigator.globalPrivacyControl === true) {
        // GPC: honor automatically, do not load, do not store a record
        return;
      }

      if (readOptOut()) {
        // Previously opted out — disable GA and don't load
        window['ga-disable-' + GA_ID] = true;
        return;
      }

      initAnalytics();
    })();
  </script>
)}
