---
import FaqList from './FaqList.astro';
import type { FaqItem } from '../../lib/faq-schema';

interface Props {
  eyebrow: string;
  heading: string;
  items: FaqItem[];
}

const { eyebrow, heading, items } = Astro.props;
---

<section class="relative bg-brand-dark py-20 px-6 sm:px-8 lg:px-12">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-14">
      <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">{eyebrow}</span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl text-brand-white uppercase tracking-tight">{heading}</h2>
      <div class="w-12 h-[2px] bg-brand-orange mx-auto mt-5"></div>
    </div>

    <FaqList items={items} />
  </div>
</section>
