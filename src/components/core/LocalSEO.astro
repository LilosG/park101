---
import { getEntry } from 'astro:content';
import { getGoogleMapsPlace } from '../../lib/googleMaps';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const siteProfile = (await getEntry('siteSettings', 'site-settings'))!.data;
const googleMaps = await getGoogleMapsPlace(siteProfile);

const {
  title,
  description,
  canonical,
  ogImage = siteProfile.seo.ogImage,
  noindex = false,
} = Astro.props;

const siteUrl = siteProfile.url.replace(/\/$/, '');
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, `${siteUrl}/`).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const businessImageUrl = siteProfile.seo.ogImage.startsWith('http')
  ? siteProfile.seo.ogImage
  : `${siteUrl}${siteProfile.seo.ogImage}`;
const logoUrl = siteProfile.logo.startsWith('http') ? siteProfile.logo : `${siteUrl}${siteProfile.logo}`;
const businessId = `${siteUrl}/#restaurant`;
const websiteId = `${siteUrl}/#website`;
const isHomePage = Astro.url.pathname === '/';

const fullTitle = (title.includes('Park 101') || title.includes('PRK 101'))
  ? title
  : `${title} | Park 101`;

function to24Hour(time: string, isClose = false): string {
  const match = time.trim().match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
  if (!match) return time;
  let [, hourStr, minute, meridiem] = match;
  let hour = parseInt(hourStr, 10);
  if (meridiem.toUpperCase() === 'AM' && hour === 12) hour = 0;
  if (meridiem.toUpperCase() === 'PM' && hour !== 12) hour += 12;
  if (isClose && hour === 0 && minute === '00') return '24:00';
  return `${String(hour).padStart(2, '0')}:${minute}`;
}

const dayOrder = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'] as const;
const dayLabel: Record<(typeof dayOrder)[number], string> = {
  monday: 'Monday',
  tuesday: 'Tuesday',
  wednesday: 'Wednesday',
  thursday: 'Thursday',
  friday: 'Friday',
  saturday: 'Saturday',
  sunday: 'Sunday',
};

const openingHoursSpecification: Array<{
  '@type': string;
  dayOfWeek: string[];
  opens: string;
  closes: string;
}> = [];

for (const day of dayOrder) {
  const dayHours = siteProfile.hours[day];
  const opens = to24Hour(dayHours.open);
  const closes = to24Hour(dayHours.close, true);
  const last = openingHoursSpecification[openingHoursSpecification.length - 1];
  if (last && last.opens === opens && last.closes === closes) {
    last.dayOfWeek.push(dayLabel[day]);
  } else {
    openingHoursSpecification.push({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [dayLabel[day]],
      opens,
      closes,
    });
  }
}

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': ['Restaurant', 'BarOrPub'],
  '@id': businessId,
  name: siteProfile.name,
  alternateName: siteProfile.brandName,
  description: siteProfile.description,
  url: siteUrl,
  image: businessImageUrl,
  logo: logoUrl,
  telephone: siteProfile.contact.phoneDial,
  priceRange: siteProfile.schema.priceRange,
  servesCuisine: siteProfile.schema.servesCuisine,
  currenciesAccepted: siteProfile.schema.currenciesAccepted,
  paymentAccepted: siteProfile.schema.paymentAccepted,
  acceptsReservations: siteProfile.ordering.reservationsUrl,
  hasMenu: `${siteUrl}/menu`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteProfile.contact.address.street,
    addressLocality: siteProfile.contact.address.city,
    addressRegion: siteProfile.contact.address.state,
    postalCode: siteProfile.contact.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteProfile.contact.coordinates.lat,
    longitude: siteProfile.contact.coordinates.lng,
  },
  hasMap: googleMaps.placeUrl,
  openingHoursSpecification,
  amenityFeature: siteProfile.schema.amenityFeature.map((name: string) => ({
    '@type': 'LocationFeatureSpecification',
    name,
    value: true,
  })),
  sameAs: [siteProfile.social.instagram, siteProfile.social.facebook].filter(Boolean),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  url: `${siteUrl}/`,
  name: siteProfile.name,
  alternateName: siteProfile.brandName,
  publisher: { '@id': businessId },
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={noindex
    ? 'noindex, nofollow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content={siteProfile.name} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
{isHomePage && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
