---
interface StatItem {
  label: string;
  value: string;
}

interface Props {
  items: StatItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class={`w-full bg-brand-dark/95 border-y border-brand-white/10 ${className}`}>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-y-0 md:divide-x divide-brand-white/10 text-center">
      {items.map((stat) => (
        <div class="px-4 py-5 sm:py-6 border-b border-brand-white/10 md:border-b-0 last:border-b-0">
          <span class="block font-display font-bold text-xl sm:text-2xl text-brand-white uppercase tracking-wide leading-tight">{stat.value}</span>
          <span class="block font-body text-[10px] sm:text-xs tracking-stat uppercase text-brand-orange mt-1">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</div>
