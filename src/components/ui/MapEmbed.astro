---
interface Props {
  src: string;
  title: string;
  class?: string;
}

const { src, title, class: containerClass = '' } = Astro.props;
---

<div class:list={['map-embed-wrapper', containerClass]}>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  ></iframe>
</div>

<style>
  .map-embed-wrapper {
    position: relative;
    overflow: hidden;
  }

  .map-embed-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
