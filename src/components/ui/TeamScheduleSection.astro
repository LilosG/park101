---
import { Image } from 'astro:assets';

interface Game {
  week?: number | string;
  date: string;
  opponent: string;
  time: string;
  home?: boolean | null;
}

interface Props {
  id?: string;
  imageSrc: ImageMetadata;
  imageAlt: string;
  eyebrow: string;
  heading: string;
  note: string;
  games: Game[];
  reservationUrl: string;
  imageLeft?: boolean;
  ctaLabel?: string;
  disclaimer?: string;
  sectionBg?: string;
}

const {
  id,
  imageSrc,
  imageAlt,
  eyebrow,
  heading,
  note,
  games,
  reservationUrl,
  imageLeft = true,
  ctaLabel = 'Reserve for Game Day',
  disclaimer = 'Schedule subject to change. Verify with the team before game day.',
  sectionBg = 'bg-brand-cream',
} = Astro.props;

const imageOrder = imageLeft ? 'lg:order-1' : 'lg:order-2';
const contentOrder = imageLeft ? 'lg:order-2' : 'lg:order-1';

const [categoryLabel, ...teamParts] = eyebrow.split('·').map((part) => part.trim()).filter(Boolean);
const teamName = teamParts.length > 0 ? teamParts.join(' · ') : eyebrow;
const scheduleLabel = categoryLabel && teamParts.length > 0 ? `${categoryLabel} · ${heading}` : heading;
---

<section id={id} class={`relative ${sectionBg}`}>
  <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch min-h-[700px]">
    <div class={`relative lg:col-span-5 min-h-[400px] lg:min-h-full overflow-hidden ${imageOrder}`}>
      <Image
        src={imageSrc}
        alt={imageAlt}
        class="absolute inset-0 w-full h-full object-cover object-center"
        loading="lazy"
        decoding="async"
        widths={[640, 828, 1080, 1400]}
        sizes="(min-width: 1024px) 42vw, 100vw"
      />
    </div>
    <div class={`lg:col-span-7 flex flex-col justify-center px-6 sm:px-10 lg:px-14 py-16 lg:py-24 ${sectionBg} ${contentOrder}`}>
      <div class="max-w-2xl mx-auto w-full">
        <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">{scheduleLabel}</span>
        <h2 class="font-display font-bold text-4xl sm:text-5xl text-brand-dark uppercase leading-display tracking-tight mb-3">{teamName}</h2>
        <div class="w-12 h-[2px] bg-brand-orange mb-6"></div>
        <p class="font-body font-light text-brand-dark/70 text-sm leading-relaxed mb-6">{note}</p>

        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b-2 border-brand-dark/20">
                <th class="font-display font-bold text-xs uppercase tracking-wider text-brand-dark/50 text-left pb-2 pr-4">Wk</th>
                <th class="font-display font-bold text-xs uppercase tracking-wider text-brand-dark/50 text-left pb-2 pr-4">Date</th>
                <th class="font-display font-bold text-xs uppercase tracking-wider text-brand-dark/50 text-left pb-2 pr-4">Matchup</th>
                <th class="font-display font-bold text-xs uppercase tracking-wider text-brand-dark/50 text-right pb-2">Kickoff (PT)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-dark/10">
              {games.map((game) => (
                <tr class={game.home === null ? 'opacity-40' : ''}>
                  <td class="py-2 pr-4 font-display font-bold text-xs text-brand-dark/40">{game.week ?? '—'}</td>
                  <td class="py-2 pr-4 font-body text-brand-dark/70 whitespace-nowrap">{game.date}</td>
                  <td class="py-2 pr-4 font-body text-brand-dark font-medium">{game.opponent}</td>
                  <td class="py-2 text-right font-display font-bold text-xs text-brand-orange whitespace-nowrap">{game.time}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="font-body text-xs text-brand-dark/40 mt-4 mb-8">{disclaimer}</p>

        <a
          href={reservationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-6 py-3.5 border border-brand-dark hover:bg-brand-dark hover:text-brand-white text-brand-dark font-display font-bold uppercase tracking-button-outline text-xs transition-all duration-200"
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </div>
</section>
