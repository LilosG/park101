---
import { getEntry } from 'astro:content';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const currentPath = Astro.url.pathname;
const siteProfile = (await getEntry('siteSettings', 'site-settings'))!.data;
const navigation = (await getEntry('navigation', 'navigation'))!.data;
const navLinks = navigation.mainLinks;
---

<header
  id="site-nav"
  class={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${transparent ? 'nav-transparent' : 'nav-solid'}`}
  data-transparent={transparent ? 'true' : 'false'}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-(--site-header-height)">

      <!-- Logo -->
      <a href={navigation.links.home} class="flex items-center flex-shrink-0" aria-label={navigation.labels.homeAria}>
        <img
          src={siteProfile.logoLight}
          alt="Park 101"
          class="h-10 w-auto"
          width="100"
          height="108"
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-0.5 min-w-0" aria-label={navigation.labels.mainAria}>
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`nav-link px-1.5 xl:px-2.5 py-2 text-xs font-display font-bold uppercase tracking-wider transition-colors duration-200 whitespace-nowrap ${
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href + '/'))
                ? 'nav-link-active'
                : ''
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Desktop CTAs -->
      <div class="hidden lg:flex items-center gap-1.5 xl:gap-3 flex-shrink-0">
        <a
          href={`tel:${siteProfile.contact.phoneDial}`}
          data-cta-location="nav_desktop"
          class="nav-phone inline-flex min-h-11 items-center px-2 py-2 text-xs font-display font-bold tracking-wider whitespace-nowrap rounded-sm transition-colors duration-200 hover:text-brand-orange"
        >{siteProfile.contact.phone}</a>
        <a
          href={siteProfile.ordering.toastUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 xl:px-4 py-2 text-xs font-display font-bold uppercase tracking-wider border border-current nav-cta-outline transition-all duration-200 hover:bg-brand-orange hover:border-brand-orange hover:text-brand-white rounded-sm whitespace-nowrap"
        >{navigation.labels.desktopOrder}</a>
        <a
          href={siteProfile.ordering.reservationsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 xl:px-4 py-2 text-xs font-display font-bold uppercase tracking-wider bg-brand-orange text-brand-white hover:bg-brand-orange-dark transition-colors duration-200 rounded-sm whitespace-nowrap"
        >{navigation.labels.desktopReserve}</a>
      </div>

      <!-- Mobile Hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5"
        aria-label={navigation.labels.openMenuAria}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-bar block w-6 h-0.5 bg-current"></span>
        <span class="hamburger-bar block w-6 h-0.5 bg-current"></span>
        <span class="hamburger-bar block w-6 h-0.5 bg-current"></span>
      </button>

    </div>
  </div>
</header>

<!-- Mobile Full-Screen Drawer -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-brand-dark flex flex-col justify-start px-6 sm:px-8 pt-[max(1.5rem,env(safe-area-inset-top))] pb-[max(2rem,env(safe-area-inset-bottom))] overflow-y-auto overscroll-contain opacity-0 invisible transition-opacity duration-300"
  aria-hidden="true"
  inert
>
  <!-- Close button -->
  <button
    id="mobile-close-btn"
    class="fixed top-[max(1.5rem,env(safe-area-inset-top))] right-6 z-50 text-brand-white p-2"
    aria-label={navigation.labels.closeMenuAria}
  >
    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Mobile Logo -->
  <div class="mb-6 pr-16">
    <img
      src={siteProfile.logoLight}
      alt="Park 101"
      class="h-12 w-auto"
      width="100"
      height="108"
    />
  </div>

  <!-- Mobile Links -->
  <nav class="flex flex-col" aria-label={navigation.labels.mobileAria}>
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="py-3.5 text-xl sm:text-2xl font-display font-bold uppercase tracking-wider text-brand-white hover:text-brand-orange transition-colors duration-150 border-b border-brand-dark-light"
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Mobile CTAs -->
  <div class="flex flex-col gap-3 mt-6 shrink-0">
    <a
      href={siteProfile.ordering.toastUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full py-4 text-center text-base sm:text-lg font-display font-bold uppercase tracking-wider border border-brand-white text-brand-white hover:bg-brand-orange hover:border-brand-orange transition-all duration-200 rounded-sm"
    >{navigation.labels.mobileOrder}</a>
    <a
      href={siteProfile.ordering.reservationsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full py-4 text-center text-base sm:text-lg font-display font-bold uppercase tracking-wider bg-brand-orange text-brand-white hover:bg-brand-orange-dark transition-colors duration-200 rounded-sm"
    >{navigation.labels.mobileReserve}</a>
  </div>
</div>

<style>
  /* Transparent state — over hero images */
  .nav-transparent {
    background: transparent;
  }
  .nav-transparent .nav-link,
  .nav-transparent .nav-phone,
  .nav-transparent #mobile-menu-btn {
    color: var(--color-brand-white);
  }
  .nav-transparent .nav-cta-outline {
    color: var(--color-brand-white);
    border-color: rgba(253, 250, 247, 0.6);
  }

  /* Solid state */
  .nav-solid {
    background: var(--color-brand-dark);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06);
  }
  .nav-solid .nav-link,
  .nav-solid .nav-phone,
  .nav-solid #mobile-menu-btn {
    color: var(--color-brand-white);
  }
  .nav-solid .nav-cta-outline {
    color: var(--color-brand-white);
    border-color: rgba(253, 250, 247, 0.4);
  }

  /* Active link */
  .nav-link-active {
    color: var(--color-brand-orange) !important;
  }

  /* Scrolled state — applied by JS */
  .nav-scrolled {
    background: var(--color-brand-dark) !important;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06);
  }
  .nav-scrolled .nav-link,
  .nav-scrolled .nav-phone,
  .nav-scrolled #mobile-menu-btn {
    color: var(--color-brand-white) !important;
  }
  .nav-scrolled .nav-cta-outline {
    color: var(--color-brand-white) !important;
    border-color: rgba(253, 250, 247, 0.4) !important;
  }

  /* Hide the fixed header while the mobile drawer is open so only
     the drawer's logo and close control are rendered. */
  #site-nav.mobile-drawer-open {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Mobile drawer open state */
  #mobile-menu.menu-open {
    opacity: 1;
    visibility: visible;
  }

  /* Let the drawer itself scroll while the page behind it remains locked. */
  #mobile-menu {
    height: 100dvh;
    -webkit-overflow-scrolling: touch;
  }

  .nav-phone:focus-visible {
    outline: 2px solid var(--color-brand-white);
    outline-offset: 2px;
  }
</style>

<script>
  let disposeNav: (() => void) | undefined;
  let initializedHeader: HTMLElement | null = null;

  function initNav() {
    const header = document.getElementById('site-nav');
    const menuButton = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const closeButton = document.getElementById('mobile-close-btn');
    if (!header || !menuButton || !menu || !closeButton) return;
    if (header === initializedHeader) return;
    disposeNav?.();
    initializedHeader = header;

    const controller = new AbortController();
    const signal = controller.signal;
    const desktop = matchMedia('(min-width: 64rem)');
    const covered = [header, document.getElementById('main-content'), document.querySelector('footer'), document.getElementById('mobile-action-bar'), document.getElementById('lilos-consent-banner')].filter((el): el is HTMLElement => el instanceof HTMLElement);
    let previousInert: boolean[] = [];
    let previousBodyStyle = '';
    let scrollY = 0;
    let isOpen = false;

    const onScroll = () => {
      if (header.dataset.transparent !== 'true') return;
      header.classList.toggle('nav-scrolled', window.scrollY > 50);
      header.classList.toggle('nav-transparent', window.scrollY <= 50);
    };

    const closeMenu = (restoreFocus = true) => {
      if (!isOpen) return;
      isOpen = false;
      menu.classList.remove('menu-open');
      menu.setAttribute('aria-hidden', 'true');
      menu.inert = true;
      menuButton.setAttribute('aria-expanded', 'false');
      header.classList.remove('mobile-drawer-open');
      document.body.classList.remove('mobile-drawer-open');
      covered.forEach((el, index) => { el.inert = previousInert[index]; });
      document.body.style.cssText = previousBodyStyle;
      window.scrollTo({ top: scrollY, behavior: 'instant' });
      onScroll();
      if (restoreFocus) {
        (desktop.matches ? header.querySelector<HTMLElement>('nav a') : menuButton)?.focus();
      }
    };

    const openMenu = () => {
      if (isOpen || desktop.matches) return;
      isOpen = true;
      scrollY = window.scrollY;
      previousBodyStyle = document.body.style.cssText;
      previousInert = covered.map(el => el.inert);
      covered.forEach(el => { el.inert = true; });
      menu.inert = false;
      menu.classList.add('menu-open');
      menu.setAttribute('aria-hidden', 'false');
      menuButton.setAttribute('aria-expanded', 'true');
      header.classList.add('mobile-drawer-open');
      document.body.classList.add('mobile-drawer-open');
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
      closeButton.focus();
    };

    menuButton.addEventListener('click', openMenu, { signal });
    closeButton.addEventListener('click', () => closeMenu(), { signal });
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => closeMenu(), { signal }));
    document.addEventListener('keydown', event => {
      if (!isOpen) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu();
      } else if (event.key === 'Tab') {
        const focusable = [...menu.querySelectorAll<HTMLElement>('a, button')];
        const first = focusable[0];
        const last = focusable.at(-1);
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    }, { signal });
    desktop.addEventListener('change', () => { if (desktop.matches) closeMenu(); }, { signal });
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    onScroll();

    disposeNav = () => { closeMenu(false); controller.abort(); initializedHeader = null; };
    document.addEventListener('astro:before-swap', () => disposeNav?.(), { once: true, signal });
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
