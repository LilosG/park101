---
import PageHero from '../components/core/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import MapEmbed from '../components/ui/MapEmbed.astro';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getGoogleMapsPlace } from '../lib/googleMaps';
import storefrontImage from '../assets/venue/park-101-modern-brick-storefront-neon-signage-carlsbad.jpg';

const siteProfile = (await getEntry('siteSettings', 'site-settings'))!.data;
const page = (await getCollection('contactPage'))[0].data;
const googleMaps = await getGoogleMapsPlace(siteProfile);
const pageTitle = page.seo.title;
const pageDescription = page.seo.description;
const visitSection = page.sections.visit;

// hours are stored as { monday: {open, close}, ... } — format properly,
// don't interpolate the nested object directly
const hoursList = Object.entries(
  siteProfile.hours as Record<string, { open: string; close: string }>
).map(([day, time]) => ({
  label: day.charAt(0).toUpperCase() + day.slice(1),
  time: `${time.open} – ${time.close}`,
}));

const hasEmail = Boolean(siteProfile.contact.email);
---

<Layout title={pageTitle} description={pageDescription} ogImage={page.seo.ogImage} transparentNav={true}>

  <!-- ── HERO ─────────────────────────────────────────────── -->
  <PageHero
    image={storefrontImage}
    imageAlt="Park 101 storefront and signage in Carlsbad Village"
    eyebrow={page.hero.eyebrow}
    heading={page.hero.heading}
    body={page.hero.body}
    primary={{ label: 'Reserve a Table', href: siteProfile.ordering.reservationsUrl, external: true }}
    secondary={{ label: 'Call Us', href: `tel:${siteProfile.contact.phoneDial}` }}
  />

  <!-- ── INFO + MAP ───────────────────────────────────────── -->
  {visitSection && (
  <section class="relative bg-brand-cream">
    <div class="grid grid-cols-1 lg:grid-cols-2 items-stretch min-h-[550px]">
      <div class="flex flex-col justify-center px-6 sm:px-12 lg:px-16 py-16 lg:py-24 bg-brand-cream">
        <div class="max-w-md mx-auto lg:mx-0 w-full">
          <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">{visitSection.eyebrow}</span>
          <h2 class="font-display font-bold text-3xl text-brand-dark uppercase leading-display tracking-tight mb-4">{visitSection.heading}</h2>
          <div class="w-12 h-[2px] bg-brand-orange mb-10"></div>

          <div class="space-y-10">
            <div>
              <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-2">
                Address
              </span>
              <a
                href={googleMaps.placeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-display font-bold text-2xl text-brand-dark hover:text-brand-orange transition-colors duration-200"
              >
                {siteProfile.contact.address.full}
              </a>
              <p class="font-body text-brand-dark/60 text-sm mt-1">{siteProfile.contact.neighborhood}, Carlsbad, CA</p>
            </div>

            <div>
              <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-2">
                Phone
              </span>
              <a
                href={`tel:${siteProfile.contact.phone}`}
                class="font-display font-bold text-2xl text-brand-dark hover:text-brand-orange transition-colors duration-200"
              >
                {siteProfile.contact.phone}
              </a>
            </div>

            {hasEmail && (
              <div>
                <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-2">
                  Email
                </span>
                <a
                  href={`mailto:${siteProfile.contact.email}`}
                  class="font-display font-bold text-2xl text-brand-dark hover:text-brand-orange transition-colors duration-200 break-all"
                >
                  {siteProfile.contact.email}
                </a>
              </div>
            )}

            <div>
              <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">
                Hours
              </span>
              <ul class="space-y-1">
                {hoursList.map((entry) => (
                  <li class="flex justify-between font-body text-brand-dark/80 text-sm max-w-xs">
                    <span class="font-bold">{entry.label}</span>
                    <span>{entry.time}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="flex flex-wrap gap-3">
              <a
                href={siteProfile.ordering.reservationsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block px-8 py-4 bg-brand-orange hover:bg-brand-orange-dark text-brand-white font-display font-bold uppercase tracking-button text-sm transition-colors duration-200"
              >
                Reserve a Table
              </a>
              <a
                href={googleMaps.directionsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block px-8 py-4 border border-brand-dark hover:bg-brand-dark hover:text-brand-white text-brand-dark font-display font-bold uppercase tracking-button-outline text-sm transition-all duration-200"
              >
                Get Directions
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="relative min-h-[400px] lg:min-h-full overflow-hidden p-4 lg:p-6 bg-brand-dark">
        <MapEmbed
          src={googleMaps.embedUrl}
          title="Park 101 on Google Maps"
          class="relative w-full h-full min-h-[380px]"
        />
      </div>
    </div>
  </section>
  )}

</Layout>
