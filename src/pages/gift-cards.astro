---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/core/PageHero.astro';
import SplitIntro from '../components/core/SplitIntro.astro';
import FullMenuBand from '../components/core/FullMenuBand.astro';
import FaqList from '../components/core/FaqList.astro';
import FaqSchema from '../components/core/FaqSchema.astro';
import { resolveContentImage } from '../lib/images';
import { fillFacts } from '../lib/site-facts';
const page = (await getCollection('giftCardsPage'))[0].data;
const site = (await getEntry('siteSettings', 'site-settings'))!.data;
const faqs = page.faqs.map(item => ({ ...item, a: fillFacts(item.a, site) }));
const canonical = `${site.url}/gift-cards`;
const schema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: page.seo.title, description: page.seo.description, about: { '@id': `${site.url}/#restaurant` } };
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: site.url }, { '@type': 'ListItem', position: 2, name: 'Gift Cards', item: canonical }] };
---
<Layout title={page.seo.title} description={page.seo.description} ogImage={page.seo.ogImage} canonical={canonical} transparentNav={true}>
  <PageHero image={resolveContentImage(page.heroImage)} imageAlt={page.heroImageAlt} {...page.hero} primary={{ label: page.purchaseLabel, href: page.purchaseUrl }} secondary={{ label: page.balanceLabel, href: page.balanceUrl }} />
  <div class="bg-brand-dark text-brand-cream/80 text-center px-6 py-4 font-body text-sm">Secure purchase and digital delivery through Toast.</div>
  <SplitIntro image={resolveContentImage(page.introImage)} imageAlt={page.introImageAlt} {...page.intro} ctaLabel="Explore the Food & Drink Menu" ctaHref="/menu" />
  <section aria-labelledby="gift-steps" class="bg-brand-cream-dark px-6 sm:px-8 lg:px-12 py-20">
    <div class="max-w-6xl mx-auto">
      <h2 id="gift-steps" class="font-display uppercase font-bold text-3xl sm:text-4xl text-center mb-12">{page.stepsHeading}</h2>
      <ol class="grid md:grid-cols-3 gap-10">{page.steps.map(item => <li class="border-t border-brand-dark/20 pt-6"><span aria-hidden="true" class="font-display text-4xl text-brand-orange">{item.step}</span><h3 class="font-display uppercase font-bold text-2xl mt-4 mb-3">{item.title}</h3><p class="font-body text-brand-dark/75 leading-relaxed">{item.body}</p></li>)}</ol>
    </div>
  </section>
  <section aria-labelledby="gift-guides" class="px-6 sm:px-8 lg:px-12 py-16 bg-brand-cream">
    <div class="max-w-5xl mx-auto"><h2 id="gift-guides" class="font-display font-bold uppercase text-3xl sm:text-4xl mb-8">{page.guidesHeading}</h2><div class="grid md:grid-cols-2 gap-6">{page.guides.map(guide => <a href={guide.href} class="block border border-brand-dark/20 p-8 hover:border-brand-orange transition-colors"><span class="block font-body text-xs uppercase tracking-widest text-brand-orange mb-3">The Park 101 Journal</span><h3 class="font-display font-bold text-2xl uppercase">{guide.label}</h3><span class="block mt-5 font-body underline underline-offset-4 text-sm">Read the guide →</span></a>)}</div></div>
  </section>
  <section aria-labelledby="gift-faq" class="bg-brand-dark px-6 sm:px-8 lg:px-12 py-16"><div class="max-w-3xl mx-auto"><h2 id="gift-faq" class="text-brand-white font-display font-bold uppercase text-3xl sm:text-4xl mb-10 text-center">Gift Card Questions</h2><FaqList items={faqs} /></div></section>
  <FullMenuBand {...page.final} ctaLabel={page.purchaseLabel} ctaHref={page.purchaseUrl} ctaExternal={false}><p class="font-body text-sm text-brand-white/80 mt-6"><a class="underline underline-offset-4" href={page.balanceUrl}>{page.balanceLabel}</a><span aria-hidden="true"> · </span><a class="underline underline-offset-4" href="/contact">Contact Park 101</a></p></FullMenuBand>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <FaqSchema items={faqs} />
</Layout>
