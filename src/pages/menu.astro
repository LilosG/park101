---
import PageHero from '../components/core/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import MenuItemCard from '../components/menu/MenuItemCard.astro';
import StatBar from '../components/core/StatBar.astro';
import SplitIntro from '../components/core/SplitIntro.astro';
import FullMenuBand from '../components/core/FullMenuBand.astro';
import FaqSection from '../components/core/FaqSection.astro';
import FaqSchema from '../components/core/FaqSchema.astro';
import { fillFacts } from '../lib/site-facts';
import { Image } from 'astro:assets';
import { resolveContentImage } from '../lib/images';

import foodSpreadImg from '../assets/food/park-101-prk-food-spread-carlsbad.jpg';
import foodSpreadIntroImg from '../assets/food/park-101-food-spread-intro-carlsbad.jpg';

const siteProfile = (await getEntry('siteSettings', 'site-settings'))!.data;
const page = (await getCollection('menuPage'))[0].data;
const dinnerFoodItems = (await getCollection('dinnerFoodItems')).sort((a, b) => a.data.order - b.data.order);
const dinnerDrinkItems = (await getCollection('dinnerDrinkItems')).sort((a, b) => a.data.order - b.data.order);
const toCardItem = ({ data }: (typeof dinnerFoodItems)[number] | (typeof dinnerDrinkItems)[number]) => ({
  ...data,
  src: resolveContentImage(data.image),
  alt: data.imageAlt,
});
const menuItems = dinnerFoodItems.map(toCardItem);
const cocktailItems = dinnerDrinkItems.map(toCardItem);

const pageTitle = page.seo.title;
const pageDescription = page.seo.description;
const foodSection = page.sections.food;
const drinkSection = page.sections.drink;
const fullMenuSection = page.sections.fullMenu;
const faqSection = page.sections.faq;
const faqs = page.faqs.map(({ q, a }) => ({ q, a: fillFacts(a, siteProfile) }));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteProfile.url },
    { '@type': 'ListItem', position: 2, name: 'Menu', item: `${siteProfile.url}/menu` },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} ogImage={page.seo.ogImage} transparentNav={true}>

  <!-- ── HERO ─────────────────────────────────────────────── -->
  <PageHero
    image={foodSpreadImg}
    imageAlt="A spread of BBQ dishes at Park 101 Carlsbad"
    eyebrow={page.hero.eyebrow}
    heading={page.hero.heading}
    body={page.hero.body}
    primary={{ label: 'Reserve a Table', href: siteProfile.ordering.reservationsUrl, external: true }}
    secondary={{ label: siteProfile.ordering.menuCtaLabel, href: siteProfile.ordering.toastUrl, external: true }}
  />

  <!-- ── STAT BAR ─────────────────────────────────────────── -->
  <StatBar stats={page.stats} />

  <!-- ── INTRO ────────────────────────────────────────────── -->
  {page.intro && (
    <SplitIntro
      image={foodSpreadIntroImg}
      imageAlt="A spread of wood-smoked BBQ dishes at Park 101 Carlsbad"
      eyebrow={page.intro.eyebrow}
      heading={page.intro.heading}
      body={page.intro.body}
      ctaLabel={siteProfile.ordering.menuCtaLabel}
      ctaHref={siteProfile.ordering.toastUrl}
      ctaExternal={true}
    />
  )}

  <!-- ── MENU GRID ────────────────────────────────────────── -->
  {foodSection && (
  <section class="relative bg-brand-steel py-20 px-6 sm:px-8 lg:px-12">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-xl mx-auto mb-14">
        <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">{foodSection.eyebrow}</span>
        <h2 class="font-display font-bold text-4xl sm:text-5xl text-brand-white uppercase tracking-tight">{foodSection.heading}</h2>
        <div class="w-12 h-[2px] bg-brand-orange mx-auto mt-5"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {menuItems.map((item) => (
          <MenuItemCard src={item.src} alt={item.alt} name={item.name} description={item.description} />
        ))}
      </div>

      <div class="text-center mt-14">
        <a
          href={siteProfile.ordering.toastUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-4 bg-brand-orange hover:bg-brand-orange-dark text-brand-white font-display font-bold uppercase tracking-button text-sm transition-colors duration-200"
        >
          {siteProfile.ordering.menuCtaLabel}
        </a>
      </div>
    </div>
  </section>
  )}

  <!-- ── COCKTAILS ────────────────────────────────────────── -->
  {drinkSection && (
  <section class="relative bg-brand-dark py-20 px-6 sm:px-8 lg:px-12">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-xl mx-auto mb-14">
        <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">{drinkSection.eyebrow}</span>
        <h2 class="font-display font-bold text-4xl sm:text-5xl text-brand-white uppercase tracking-tight">{drinkSection.heading}</h2>
        <div class="w-12 h-[2px] bg-brand-orange mx-auto mt-5"></div>
        <p class="font-body font-light text-brand-cream/70 text-sm sm:text-base mt-6">
          <span class="font-display font-bold uppercase tracking-wide text-brand-orange">{siteProfile.happyHours.label}:</span>
          {' '}{siteProfile.happyHours.days}, {siteProfile.happyHours.hours}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {cocktailItems.map((item) => (
          <MenuItemCard src={item.src} alt={item.alt} name={item.name} description={item.description} />
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ── FULL MENU BAND ───────────────────────────────────── -->
  <FullMenuBand
    eyebrow={fullMenuSection.eyebrow}
    heading={fullMenuSection.heading}
    body={fullMenuSection.body}
    ctaLabel={siteProfile.ordering.menuCtaLabel}
    ctaHref={siteProfile.ordering.toastUrl}
  />

  <!-- ── FAQ ───────────────────────────────────────────────── -->
  <FaqSection eyebrow={faqSection.eyebrow} heading={faqSection.heading} items={faqs} />
  <FaqSchema items={faqs} />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
