---
import Layout from '../layouts/Layout.astro';
import TrustBar from '../components/ui/TrustBar.astro';
import TeamScheduleSection from '../components/ui/TeamScheduleSection.astro';
import { getEntry } from 'astro:content';

const siteProfile = (await getEntry('siteSettings', 'site-settings'))!.data;
const reservationsUrl = siteProfile.ordering.reservationsUrl;

const billsSchedule = [
  { week: 1,  date: 'Sep 13', opponent: '@ Houston Texans',          time: '10:00 AM PT', home: false },
  { week: 2,  date: 'Sep 17', opponent: 'vs Detroit Lions',          time: '5:15 PM PT',  home: true  },
  { week: 3,  date: 'Sep 27', opponent: 'vs Los Angeles Chargers',   time: '10:00 AM PT', home: true  },
  { week: 4,  date: 'Oct 4',  opponent: 'vs New England Patriots',   time: '10:00 AM PT', home: true  },
  { week: 5,  date: 'Oct 12', opponent: '@ Los Angeles Rams',        time: '5:15 PM PT',  home: false },
  { week: 6,  date: 'Oct 18', opponent: '@ Las Vegas Raiders',       time: '1:25 PM PT', home: false },
  { week: 7,  date: 'Oct 25', opponent: 'BYE WEEK',                  time: '—',           home: null  },
  { week: 8,  date: 'Nov 1',  opponent: 'vs Baltimore Ravens',       time: '10:00 AM PT', home: true  },
  { week: 9,  date: 'Nov 9',  opponent: '@ Minnesota Vikings',       time: '5:15 PM PT',  home: false },
  { week: 10, date: 'Nov 15', opponent: '@ New York Jets',           time: '10:00 AM PT', home: false },
  { week: 11, date: 'Nov 22', opponent: 'vs Miami Dolphins',         time: '10:00 AM PT', home: true  },
  { week: 12, date: 'Nov 26', opponent: 'vs Kansas City Chiefs',     time: '5:20 PM PT',  home: true  },
  { week: 13, date: 'Dec 6',  opponent: '@ New England Patriots',    time: '1:25 PM PT', home: false },
  { week: 14, date: 'Dec 13', opponent: '@ Green Bay Packers',       time: '5:20 PM PT',  home: false },
  { week: 15, date: 'Dec 19', opponent: 'vs Chicago Bears',          time: '5:20 PM PT',  home: true  },
  { week: 16, date: 'Dec 25', opponent: '@ Denver Broncos',          time: '1:30 PM PT', home: false },
  { week: 17, date: 'Jan 3',  opponent: '@ Miami Dolphins',          time: '10:00 AM PT', home: false },
  { week: 18, date: 'TBD',    opponent: 'vs New York Jets',          time: 'TBD',         home: true  },
];

const buckeyesSchedule = [
  { week: 1,  date: 'Sep 5',  opponent: 'vs Ball State',             time: '9:30 AM PT',  home: true  },
  { week: 2,  date: 'Sep 12', opponent: '@ Texas',                   time: '4:30 PM PT',  home: false },
  { week: 3,  date: 'Sep 19', opponent: 'vs Kent State',             time: '9:00 AM PT',  home: true  },
  { week: 4,  date: 'Sep 26', opponent: 'vs Illinois',               time: 'TBA',         home: true  },
  { week: 5,  date: 'Oct 3',  opponent: '@ Iowa',                    time: 'TBA',         home: false },
  { week: 6,  date: 'Oct 10', opponent: 'vs Maryland',               time: 'TBA',         home: true  },
  { week: 7,  date: 'Oct 17', opponent: '@ Indiana',                 time: 'TBA',         home: false },
  { week: 8,  date: 'Oct 24', opponent: 'OFF',                       time: '—',           home: null  },
  { week: 9,  date: 'Oct 31', opponent: '@ USC',                     time: 'TBA',         home: false },
  { week: 10, date: 'Nov 7',  opponent: 'vs Oregon',                 time: 'TBA',         home: true  },
  { week: 11, date: 'Nov 14', opponent: 'vs Northwestern',           time: 'TBA',         home: true  },
  { week: 12, date: 'Nov 21', opponent: '@ Nebraska',                time: 'TBA',         home: false },
  { week: 13, date: 'Nov 28', opponent: 'vs Michigan',               time: '9:00 AM PT',  home: true  },
];
---

<Layout
  title="Watch Buffalo Bills & Ohio State Football in Carlsbad | Park 101"
  description="Park 101 is Carlsbad's game day headquarters for Buffalo Bills and Ohio State Buckeyes football, with a massive outdoor LED wall, 20+ screens, food, drinks and reservations."
  ogImage="/images/home/seo/ogImage.jpg"
>
  <!-- HERO -->
  <section class="relative min-h-[90vh] w-full bg-brand-dark flex flex-col justify-end overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/sports/DSC09106.webp"
        alt="Buffalo Bills fans watching football at Park 101 in Carlsbad Village"
        class="w-full h-full object-cover object-[50%_15%]"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark/80 via-brand-dark/40 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/60 via-transparent to-brand-dark/20"></div>
    </div>
    <div class="h-24 shrink-0"></div>
    <div class="relative z-10 max-w-7xl w-full mx-auto px-6 sm:px-8 lg:px-12 pb-16 lg:pb-24">
      <span class="inline-block font-body text-xs font-bold tracking-eyebrow-lg uppercase text-brand-orange mb-4">Carlsbad Village &middot; Game Day Headquarters</span>
      <h1 class="font-display font-bold text-hero text-brand-white uppercase leading-ultra tracking-tight max-w-3xl mb-4">Watch Party<br />Headquarters</h1>
      <p class="font-display font-bold text-panel text-brand-orange uppercase tracking-tight leading-snug max-w-2xl mb-8">Buffalo Bills · Ohio State Buckeyes · NFL &amp; College Football</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#schedule" class="px-8 py-4 bg-brand-orange hover:bg-brand-orange-dark text-brand-white font-display font-bold uppercase tracking-button text-sm transition-colors duration-200 text-center">See the Schedule</a>
        <a href={reservationsUrl} target="_blank" rel="noopener noreferrer" class="px-8 py-4 border border-brand-white/60 hover:border-brand-white hover:bg-brand-white/10 text-brand-white font-display font-bold uppercase tracking-button-outline text-sm transition-all duration-200 text-center">Reserve a Table</a>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- INTRO SPLIT -->
  <section class="relative bg-brand-dark">
    <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch min-h-[700px]">
      <div class="lg:col-span-5 flex flex-col justify-center px-6 sm:px-12 lg:px-16 py-16 lg:py-24 bg-brand-dark">
        <div class="max-w-md mx-auto lg:mx-0">
          <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">Buffalo Bills &amp; College Football</span>
          <h2 class="font-display font-bold text-4xl sm:text-5xl text-brand-white uppercase leading-display tracking-tight mb-6">Carlsbad's Home<br />for Game Day</h2>
          <div class="w-12 h-[2px] bg-brand-orange mb-6"></div>
          <p class="font-body font-light text-brand-cream/70 text-base sm:text-lg leading-relaxed mb-5">Park 101's outdoor courtyard is built for game day. The massive LED wall faces the fire pit seating. The bar stays open. The kitchen runs all day. Bills games and college football Saturdays happen here every week of the season.</p>
          <p class="font-body font-light text-brand-cream/70 text-base sm:text-lg leading-relaxed mb-8">Walk-ins are always welcome. For Bills kickoffs, Ohio State games and major college matchups, a reservation is worth it.</p>
          <a href={reservationsUrl} target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-3.5 border border-brand-white hover:bg-brand-white hover:text-brand-dark text-brand-white font-display font-bold uppercase tracking-button-outline text-xs transition-all duration-200">Reserve a Table</a>
        </div>
      </div>
      <div class="relative lg:col-span-7 min-h-[400px] lg:min-h-full overflow-hidden">
        <img
          src="/images/sports/DSC09103.webp"
          alt="Buffalo Bills fans in Josh Allen and James Cook jerseys watching football on Park 101's outdoor LED screen"
          class="absolute inset-0 w-full h-full object-cover object-[50%_46%]"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- FULL-BLEED FEATURE -->
  <section class="relative min-h-[500px] flex items-center justify-center text-center px-6 py-24 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/sports/DSC09187.webp" alt="Fans watching football on the outdoor LED screen at Park 101 Carlsbad" class="w-full h-full object-cover object-[50%_40%]" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-brand-dark/65"></div>
    </div>
    <div class="relative z-10 max-w-2xl w-full mx-auto">
      <span class="inline-block font-body text-xs font-bold tracking-eyebrow-lg uppercase text-brand-orange mb-4">Park 101 · Carlsbad Village</span>
      <h2 class="font-display font-bold text-5xl sm:text-6xl text-brand-white uppercase tracking-tight leading-ultra mb-6">Every Game.<br />Every Season.</h2>
      <p class="font-body font-light text-brand-cream/80 text-base sm:text-lg leading-relaxed mb-8 max-w-lg mx-auto">Bills football, Ohio State Saturdays and NFL Sunday windows from the first kickoff through primetime.</p>
      <a href="#schedule" class="inline-block px-8 py-4 bg-brand-orange hover:bg-brand-orange-dark text-brand-white font-display font-bold uppercase tracking-button text-sm transition-colors duration-200">View the Schedule</a>
    </div>
  </section>

  <TeamScheduleSection
    id="schedule"
    imageSrc="/images/sports/DSC09076.webp"
    imageAlt="Buffalo Bills game day food and fan gear at Park 101 Carlsbad"
    eyebrow="NFL · Buffalo Bills"
    heading="2026 Schedule"
    note="All times Pacific. Walk-ins welcome — reserve for big games."
    games={billsSchedule}
    reservationUrl={reservationsUrl}
    disclaimer="Schedule subject to NFL flex scheduling. Verify with the Buffalo Bills before game day."
  />

  <TeamScheduleSection
    id="ohio-state-schedule"
    imageSrc="/images/sports/DSC09209.webp"
    imageAlt="College football watch party crowd at Park 101 Carlsbad"
    eyebrow="College Football · Ohio State Buckeyes"
    heading="2026 Schedule"
    note="All listed kickoff times are Pacific. TBA games will be updated as official times are announced."
    games={buckeyesSchedule}
    reservationUrl={reservationsUrl}
    imageLeft={false}
    ctaLabel="Reserve for Buckeyes Game Day"
    disclaimer="Schedule and kickoff times subject to change. Verify with Ohio State Athletics before game day."
    sectionBg="bg-brand-tan"
  />

  <!-- COLLEGE FOOTBALL -->
  <section class="relative bg-brand-dark">
    <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch min-h-[700px]">
      <div class="lg:col-span-6 order-2 lg:order-1 flex flex-col justify-center px-6 sm:px-12 lg:px-16 py-16 lg:py-24 bg-brand-dark">
        <div class="max-w-md mx-auto lg:mx-0">
          <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">College Football</span>
          <h2 class="font-display font-bold text-4xl sm:text-5xl text-brand-white uppercase leading-display tracking-tight mb-6">Every Saturday.<br />Every Conference.</h2>
          <div class="w-12 h-[2px] bg-brand-orange mb-6"></div>
          <p class="font-body font-light text-brand-cream/70 text-base sm:text-lg leading-relaxed mb-5">College football Saturdays run all day at Park 101. Early kickoffs through the late-night window, with major Big Ten, SEC, Big 12 and ACC matchups across the outdoor LED wall and indoor screens.</p>
          <p class="font-body font-light text-brand-cream/70 text-base sm:text-lg leading-relaxed mb-8">Top 25 battles, rivalry games and conference races all season. Whatever your team, there is a screen for it, plus a full kitchen and bar from kickoff through the final whistle.</p>
          <div class="flex flex-wrap gap-x-6 gap-y-3 mb-8 pb-8 border-b border-brand-white/10">
            {['Big Ten', 'SEC', 'Big 12', 'ACC', 'National Games'].map((conf) => (
              <span class="font-display font-bold text-xs uppercase tracking-feature text-brand-white">{conf}</span>
            ))}
          </div>
          <a href={reservationsUrl} target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-3.5 border border-brand-white hover:bg-brand-white hover:text-brand-dark text-brand-white font-display font-bold uppercase tracking-button-outline text-xs transition-all duration-200">Reserve for Saturday</a>
        </div>
      </div>
      <div class="relative lg:col-span-6 order-1 lg:order-2 min-h-[400px] lg:min-h-full overflow-hidden">
        <img src="/images/sports/DSC09136.webp" alt="Buffalo Bills fans at Park 101 in Carlsbad Village" class="absolute inset-0 w-full h-full object-cover object-center" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="relative min-h-[480px] flex items-center justify-center text-center px-6 py-24 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/sports/DSC07505-HDR.webp" alt="Park 101 outdoor bar with LED screen and string lights in Carlsbad Village" class="w-full h-full object-cover object-center" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-brand-dark/70"></div>
    </div>
    <div class="relative z-10 max-w-2xl w-full mx-auto">
      <span class="inline-block font-body text-xs font-bold tracking-eyebrow-lg uppercase text-brand-orange mb-4">Park 101 · 3040 Carlsbad Blvd</span>
      <h2 class="font-display font-bold text-5xl sm:text-6xl text-brand-white uppercase tracking-tight leading-ultra mb-6">Book Your<br />Game Day Table</h2>
      <p class="font-body font-light text-brand-cream/80 text-base sm:text-lg leading-relaxed mb-8 max-w-lg mx-auto">Walk-ins are always welcome. Reservations are recommended for Bills kickoffs, Ohio State games and major college football Saturdays.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={reservationsUrl} target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-brand-orange hover:bg-brand-orange-dark text-brand-white font-display font-bold uppercase tracking-button text-sm transition-colors duration-200 text-center">Reserve Now</a>
        <a href="/contact" class="px-8 py-4 border border-brand-white/60 hover:border-brand-white hover:bg-brand-white/10 text-brand-white font-display font-bold uppercase tracking-button-outline text-sm transition-all duration-200 text-center">Hours &amp; Location</a>
      </div>
    </div>
  </section>
</Layout>
