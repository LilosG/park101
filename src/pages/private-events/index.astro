---
import FaqList from '../../components/core/FaqList.astro';
import FaqSchema from '../../components/core/FaqSchema.astro';
import PageHero from '../../components/core/PageHero.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import EventInquiryForm from '../../components/core/EventInquiryForm.astro';
import StatBar from '../../components/core/StatBar.astro';
import PrivateEventCard from '../../components/private-events/PrivateEventCard.astro';
import { Image } from 'astro:assets';
import { resolveContentImage } from '../../lib/images';
import privateEventsHero from '../../assets/venue/park-101-rooftop-evening-group-carlsbad.jpg';
import firePitPatio from '../../assets/venue/park-101-outdoor-fire-pit-patio-venue-carlsbad.jpg';

const siteProfile = (await getEntry('siteSettings', 'site-settings'))!.data;
const page = (await getCollection('privateEventsIndex'))[0].data;
const eventOrder = ['birthday-parties', 'corporate-events', 'venue-buyout', 'game-day-parties', 'rehearsal-dinners'];
const events = (await getCollection('privateEvents'))
  .map(({ data }) => data)
  .sort((a, b) => eventOrder.indexOf(a.slug) - eventOrder.indexOf(b.slug));
const faqs = page.faqs ?? [];
const howItWorks = page.howItWorks ?? [];
const privateEventsHubImage = page.seo.ogImage;

const pageTitle = page.seo.title;
const pageDescription = page.seo.description;
const typesSection = page.sections.types;
const processSection = page.sections.process;
const faqSection = page.sections.faq;
const finalSection = page.sections.final;

---

<Layout title={pageTitle} description={pageDescription} ogImage={privateEventsHubImage} transparentNav={true}>

  <!-- ── HERO ─────────────────────────────────────────────── -->
  <PageHero
    image={privateEventsHero}
    imageAlt="Evening private event gathering on the rooftop at Park 101 Carlsbad"
    eyebrow={page.hero.eyebrow}
    heading={page.hero.heading}
    body={page.hero.body}
    primary={{ label: 'Request Availability', href: '#inquiry' }}
    secondary={{ label: 'Call Us', href: `tel:${siteProfile.contact.phoneDial}` }}
  />

  <!-- ── STAT BAR ─────────────────────────────────────────── -->
  <StatBar stats={[
    { value: '300', label: 'Max Guests' },
    { value: '5', label: 'Event Types' },
    { value: '2', label: 'Levels' },
    { value: '24-Hr', label: 'Response Time' },
  ]} />

  <!-- ── WHY PARK 101 ─────────────────────────────────────── -->
  {page.intro && (
  <section class="relative bg-brand-cream">
    <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch min-h-[600px]">
      <div class="relative lg:col-span-6 min-h-[400px] lg:min-h-full overflow-hidden">
        <Image
          src={firePitPatio}
          alt="Full multi-level venue at Park 101 Carlsbad with courtyard, fire pit, and rooftop"
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="lazy"
          decoding="async"
          widths={[640, 828, 1080, 1400]}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      </div>
      <div class="lg:col-span-6 flex flex-col justify-center px-6 sm:px-12 lg:px-16 py-16 lg:py-24 bg-brand-cream">
        <div class="max-w-md mx-auto lg:mx-0">
          <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">{page.intro.eyebrow}</span>
          <h2 class="font-display font-bold text-4xl sm:text-5xl text-brand-dark uppercase leading-display tracking-tight mb-6">{page.intro.heading}</h2>
          <div class="w-12 h-[2px] bg-brand-orange mb-6"></div>
          {page.intro.body && (
            <p class="font-body font-light text-brand-dark/75 text-base sm:text-lg leading-relaxed mb-8"><Fragment set:html={page.intro.body} /></p>
          )}
          <a
            href="/venue"
            class="inline-block px-6 py-3.5 border border-brand-dark hover:bg-brand-dark hover:text-brand-white text-brand-dark font-display font-bold uppercase tracking-button-outline text-xs transition-all duration-200"
          >
            See the Full Venue
          </a>
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- ── BROWSE BY EVENT TYPE ─────────────────────────────── -->
  {typesSection && (
  <section class="relative bg-brand-dark py-20 px-6 sm:px-8 lg:px-12">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-xl mx-auto mb-14">
        <span class="block font-body text-xs font-bold tracking-eyebrow-wide uppercase text-brand-orange mb-3">{typesSection.eyebrow}</span>
        <h2 class="font-display font-bold text-4xl sm:text-5xl text-brand-white uppercase tracking-tight">{typesSection.heading}</h2>
        <div class="w-12 h-[2px] bg-brand-orange mx-auto mt-5"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {events.map((event) => (
          <PrivateEventCard event={event} image={resolveContentImage(event.image)} />
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ── HOW IT WORKS ──────────────────────────────────────── -->
  {processSection && howItWorks.length > 0 && (
  <section class="relative bg-brand-cream py-20 px-6 sm:px-8 lg:px-12">
    <div class="max-w-5xl mx-auto">
      <div class="text-center max-w-xl mx-auto mb-14">
        <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">{processSection.eyebrow}</span>
        <h2 class="font-display font-bold text-4xl sm:text-5xl text-brand-dark uppercase tracking-tight">{processSection.heading}</h2>
        <div class="w-12 h-[2px] bg-brand-orange mx-auto mt-5"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {howItWorks.map((item) => (
          <div>
            <span class="block font-display font-bold text-3xl text-brand-orange mb-3">{item.step}</span>
            <h3 class="font-display font-bold text-lg uppercase tracking-tight text-brand-dark mb-2">{item.title}</h3>
            <p class="font-body font-light text-brand-dark/70 text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ── INQUIRY FORM ─────────────────────────────────────── -->
  <EventInquiryForm />

  <!-- ── FAQ ───────────────────────────────────────────────── -->
  {faqSection && faqs.length > 0 && (
  <section id="faq" class="relative bg-brand-steel py-20 px-6 sm:px-8 lg:px-12">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-14">
        <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">{faqSection.eyebrow}</span>
        <h2 class="font-display font-bold text-4xl sm:text-5xl text-brand-white uppercase tracking-tight">{faqSection.heading}</h2>
        <div class="w-12 h-[2px] bg-brand-orange mx-auto mt-5"></div>
      </div>

      <FaqList items={faqs} />
    </div>
  </section>
  )}

  <!-- ── FINAL CTA ─────────────────────────────────────────── -->
  {finalSection && (
  <section class="relative bg-brand-dark py-20 px-6 sm:px-8 lg:px-12 text-center">
    <div class="max-w-2xl mx-auto">
      <span class="block font-body text-xs font-bold tracking-eyebrow-lg uppercase text-brand-orange mb-4"><Fragment set:html={finalSection.eyebrow} /></span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl text-brand-white uppercase leading-display tracking-tight mb-6">{finalSection.heading}</h2>
      {finalSection.body && (
        <p class="font-body font-light text-brand-cream/80 text-base sm:text-lg leading-relaxed mb-8">{finalSection.body}</p>
      )}
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#inquiry"
          class="px-8 py-4 bg-brand-orange hover:bg-brand-orange-dark text-brand-white font-display font-bold uppercase tracking-button text-sm transition-colors duration-200 text-center"
        >
          Request Availability
        </a>
        <a
          href={`tel:${siteProfile.contact.phoneDial}`}
          class="px-8 py-4 border border-brand-white/60 hover:border-brand-white hover:bg-brand-white/10 text-brand-white font-display font-bold uppercase tracking-button-outline text-sm transition-all duration-200 text-center"
        >
          {siteProfile.contact.phone}
        </a>
      </div>
    </div>
  </section>
  )}

  <FaqSchema items={faqs} />

</Layout>
