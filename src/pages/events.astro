---
import PageHero from '../components/core/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import EventInquiryForm from '../components/core/EventInquiryForm.astro';
import EventMatchupCard from '../components/events/EventMatchupCard.astro';
import { Image } from 'astro:assets';
import { resolveContentImage } from '../lib/images';
import { eventIsoDate, fallbackCutoffIso } from '../lib/event-dates';

import padresGameDayEvents from '../assets/venue/park-101-padres-game-day-packed-venue-carlsbad.jpg';

const siteProfile = (await getEntry('siteSettings', 'site-settings'))!.data;
const page = (await getCollection('eventsPage'))[0].data;
const eventTypeOrder = ['nfl-sundays', 'mlb-games', 'ufc-fight-nights', 'fantasy-draft-events', 'live-music', 'themed-nights'];
const eventTypes = (await getCollection('eventTypes'))
  .sort((a, b) => eventTypeOrder.indexOf(a.data.slug) - eventTypeOrder.indexOf(b.data.slug));

const cutoff = fallbackCutoffIso();
const upcomingEvents = (await getCollection('upcomingEvents'))
  .map((event) => ({ event, expires: eventIsoDate(event.data.date, event.data.year) }))
  .filter((item): item is { event: typeof item.event; expires: string } => item.expires !== null && item.expires >= cutoff)
  .sort((a, b) => a.expires.localeCompare(b.expires));

const pageTitle = page.seo.title;
const pageDescription = page.seo.description;
const eventTypesSection = page.sections.eventTypes;
const upcomingSection = page.sections.upcoming;
const inquirySection = page.sections.inquiry;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteProfile.url },
    { '@type': 'ListItem', position: 2, name: 'Events', item: `${siteProfile.url}/events` },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} ogImage={page.seo.ogImage} transparentNav={true}>

  <PageHero
    image={padresGameDayEvents}
    imageAlt="Packed crowd at Park 101 Carlsbad during a game day event"
    eyebrow={page.hero.eyebrow}
    heading={page.hero.heading}
    body={page.hero.body}
    primary={{ label: 'Reserve a Table', href: siteProfile.ordering.reservationsUrl, external: true }}
    secondary={{ label: 'Book a Watch Party', href: '/private-events/game-day-parties' }}
  />

  {eventTypesSection && (
  <section class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">{eventTypesSection.eyebrow}</span>
        <h2 class="font-display font-bold text-section text-brand-steel uppercase leading-display tracking-tight"><Fragment set:html={eventTypesSection.heading} /></h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {eventTypes.map(({ data: type }) => {
          const image = resolveContentImage(type.image);
          return (
            <div class="group relative aspect-[4/3] rounded-lg overflow-hidden">
              {image && (
                <Image
                  src={image}
                  alt={type.imageAlt}
                  class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                  widths={[400, 640, 800]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/90 via-brand-dark/20 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-6">
                <h3 class="font-display font-bold text-xl text-brand-white uppercase tracking-tight mb-1">
                  {type.name}
                </h3>
                <p class="font-body text-sm text-brand-white/80 leading-snug">
                  {type.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
  )}

  {upcomingSection && (
  <section class="bg-brand-dark px-6 sm:px-8 lg:px-12 py-20">
    <div class="max-w-4xl mx-auto text-center">
      <span class="block font-body text-xs font-bold tracking-label uppercase text-brand-orange mb-3">{upcomingSection.eyebrow}</span>
      <h2 class="font-display font-bold text-section text-brand-white uppercase leading-display tracking-tight mb-8">{upcomingSection.heading}</h2>
      <p data-empty-state hidden={upcomingEvents.length > 0} class="font-body text-brand-white/60 text-base max-w-lg mx-auto">
        New game day, live music, and special-event dates are added as they're announced. Follow
        {' '}<a href={siteProfile.social.instagram} target="_blank" rel="noopener noreferrer" class="text-brand-orange hover:text-brand-orange-light underline">Park 101 on Instagram</a>
        {' '}for the latest updates.
      </p>
      <div data-expiring-list hidden={upcomingEvents.length === 0} class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-left">
        {upcomingEvents.map(({ event: { data: event }, expires }) => (
          <EventMatchupCard
            category={event.category}
            sideA={event.sideA}
            sideB={event.sideB}
            date={event.date}
            time={event.time}
            image={resolveContentImage(event.image)}
            imageAlt={event.imageAlt}
            expires={expires}
          />
        ))}
      </div>
    </div>
  </section>
  )}

  {inquirySection && (
    <EventInquiryForm
      eyebrow={inquirySection.eyebrow}
      heading={inquirySection.heading}
      subtext={inquirySection.body}
    />
  )}

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
